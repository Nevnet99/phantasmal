{
	"name": "phantasmal",
	"version": "0.0.1",
	"private": true,
	"description": "Local-first Atomic Habits workspace for tracking, creating, and breaking habits",
	"type": "module",
	"main": "dist-electron/main.js",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "env -u ELECTRON_RUN_AS_NODE vite",
		"build": "tsc --noEmit && vite build",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "bun run lint && bun run format:check && bun run test && bun run build"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"lit": "^3.3.1"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.15.29",
		"electron": "^36.3.2",
		"oxlint": "^0.16.12",
		"prettier": "^3.5.3",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vite-plugin-electron": "^0.29.0",
		"vite-plugin-electron-renderer": "^0.14.6",
		"vitest": "^3.2.1"
	},
	"trustedDependencies": [
		"better-sqlite3",
		"electron"
	]
}
