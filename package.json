{
	"name": "@phantasmal/source",
	"version": "0.0.1",
	"private": true,
	"description": "Phantasmal monorepo — desktop app and marketing site",
	"author": "Nevnet99",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Nevnet99/phantasmal.git"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "bun run --filter @phantasmal/desktop dev",
		"dev:desktop": "bun run --filter @phantasmal/desktop dev",
		"dev:marketing": "bun run --filter @phantasmal/marketing dev",
		"build": "nx run-many -t build",
		"build:desktop": "bun run --filter @phantasmal/desktop build",
		"build:marketing": "bun run --filter @phantasmal/marketing build",
		"dist": "bun run --filter @phantasmal/desktop dist",
		"release": "bun run --filter @phantasmal/desktop release",
		"lint": "nx run-many -t lint",
		"typecheck": "nx run-many -t typecheck",
		"test": "nx run-many -t test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
		"sync:downloads": "bun scripts/sync-site-downloads.ts"
	},
	"devDependencies": {
		"nx": "^21.6.4",
		"oxlint": "^0.16.12",
		"prettier": "^3.5.3",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^5.8.3"
	},
	"trustedDependencies": [
		"electron"
	]
}
